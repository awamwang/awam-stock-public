{
  "packageManager": "pnpm@9.15.9",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "Awam Wang",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint packages",
    "build:declarations": "tsc --declaration --emitDeclarationOnly",
    "test": "pnpm run test:availability",
    "test:availability": "pnpm --filter @awamstock/server test:availability",
    "test:availability:api": "pnpm --filter @awamstock/server test:availability:api",
    "test:availability:third-party": "pnpm --filter @awamstock/server test:availability:third-party",
    "test:availability:files": "pnpm --filter @awamstock/server test:availability:files",
    "test:availability:server": "pnpm --filter @awamstock/server test:availability:server"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "eslint",
      "prettier --parser=typescript --write"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.3",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/preset-env": "^7.28.3",
    "@eslint/js": "^9.33.0",
    "@types/ejs": "^3.1.5",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.17.0",
    "copyfiles": "^2.4.1",
    "ejs": "^3.1.10",
    "esbuild": "^0.25.9",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jsonc-eslint-parser": "^2.4.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-toolbelt": "^9.6.0",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.1",
    "vue-eslint-parser": "^10.2.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "@sentry/node": "^9.46.0"
  }
}
