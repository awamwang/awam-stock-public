{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "availability/.*\\.availability-spec\\.ts$",
  "setupFiles": ["<rootDir>/availability/setup-env.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "transformIgnorePatterns": ["/node_modules/"],
  "testTimeout": 60000
}
