{
  "name": "@awamstock/db",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "scripts": {
    "build": "pnpm run clean && tsc -p ./tsconfig.build.json && pnpm run copy-files",
    "clean": "rimraf dist/ tsconfig.build.tsbuildinfo",
    "copy-files": "copyfiles -u 1 ./src/**/**.py ./dist/ && copyfiles ./pysrc/**/**.py ./dist/",
    "dev:ts": "pnpm run clean && pnpm run copy-files && tsc -w",
    "start:ts": "ts-node -r tsconfig-paths/register src/index.ts",
    "dev": "pnpm run start:ts",
    "lint": "eslint . --ext .ts",
    "pm2:start": "node -e \"require('fs').mkdirSync('/var/log/stock-db',{recursive:true})\" && pm2 startOrReload ecosystem.config.js --only stock-db",
    "pm2:start-ts": "pnpm install -F=db && NODE_ENV=development pm2 startOrReload ecosystem.config.js --only stock-db-ts",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@awamstock/model": "workspace:^1.0.0",
    "@awamstock/shared": "workspace:^1.0.0",
    "cron": "^4.3.3",
    "dayjs": "^1.11.13",
    "execa": "^5.1.1",
    "fs-extra": "^11.3.1",
    "lodash": "^4.17.21",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "utils-decorators": "^2.0.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "dotenv": "^16.6.1"
  }
}
