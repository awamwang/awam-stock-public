{
  "name": "@awamstock/front",
  "version": "1.0.3",
  "main": "dist/electron/main/index.js",
  "description": "Really simple Electron + Vue + Vite boilerplate.",
  "author": "Awam Wang",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "pnpm run build:server && vite",
    "dev:serve": "NODE_ENV=development ts-node -P tsconfig.server.json -r tsconfig-paths/register src/server/index.ts",
    "dev:servew": "NODE_ENV=development nodemon --exec 'ts-node -P tsconfig.server.json -r tsconfig-paths/register' src/server/index.ts",
    "dev:vue": "node ./scripts/dev-vue.mjs",
    "dev:kraken": "kraken ./dist-kraken/main.js",
    "typecheck:tsc": "tsc -p ./tsconfig.json --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist/",
    "build:vue": "vite build",
    "build:dts": "vue-tsc --declaration --emitDeclarationOnly",
    "build:ele": "electron-builder -p never",
    "pack": "electron-builder --dir",
    "build:server": "node ./esbuild.server.js",
    "build:kraken": "KRAKEN=true vite build",
    "build:all": "pnpm run clean && pnpm run lint && pnpm run typecheck:tsc && pnpm run build:server && vite build && pnpm run build:ele",
    "build": "pnpm run build:all ",
    "inspect:ele": "electron --inspect=5858 dist/win-unpacked/AwamStock.exe",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue}\" && pnpm run lint:css",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix && pnpm run lint:css:fix",
    "lint:css": "stylelint \"src/**/*.vue\"",
    "lint:css:fix": "stylelint \"src/**/*.vue\" --fix",
    "update:browserslist": "npx update-browserslist-db@latest",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@antv/data-set": "^0.11.8",
    "@antv/g2": "^4.2.10",
    "@awamstock/model": "workspace:^",
    "@awamstock/shared": "workspace:^",
    "@awamwang/vue-socket.io-extended": "0.0.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify-json/ep": "^1.2.3",
    "@iconify-json/wi": "^1.2.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@sentry/vue": "^9.46.0",
    "@types/koa": "^2.15.0",
    "@types/koa-router": "^7.4.8",
    "@types/node": "^22.17.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "ag-grid-community": "^28.2.1",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "babel-runtime": "6.26.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.2",
    "electron-updater": "^6.6.2",
    "element-plus": "^2.11.2",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "hqchart": "^1.1.11886",
    "http-proxy-middleware": "^3.0.5",
    "iconv-lite": "^0.6.3",
    "jquery": "^3.7.1",
    "koa": "^2.16.1",
    "koa-router": "^13.0.1",
    "koa2-connect": "^1.0.2",
    "lib-esm": "^0.4.2",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.3",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-preset-env": "^10.2.4",
    "postcss-sorting": "^9.1.0",
    "rollup": "^4.46.2",
    "sass": "^1.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stylelint": "^16.23.1",
    "stylelint-config-recommended-vue": "^1.4.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "terser": "^5.43.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.1",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^22.2.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-esmodule": "^1.5.0",
    "vite-plugin-inspect": "^11.3.2",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-resolve": "^2.5.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.0.5"
  },
  "env": {
    "VITE_DEV_SERVER_HOST": "localhost",
    "VITE_DEV_SERVER_PORT": 3000
  },
  "build": {
    "appId": "com.awam.app",
    "productName": "AwamStock",
    "copyright": "Copyright © year ${author}",
    "buildDependenciesFromSource": false,
    "files": [
      "dist/**/*",
      "package.json",
      "!**/awam-stock/node_modules/**/*",
      "!**/server/node_modules/**/*",
      "!**/shared/node_modules/*",
      "!**/model/node_modules/*",
      "!**/db/node_modules/*"
    ],
    "asarUnpack": [
      "dist/server/**/*"
    ],
    "extraResources": [
      {
        "from": "envs",
        "to": "envs",
        "filter": [
          "**/*",
          "!.env.development",
          "!.env.development.local",
          "!.env.example"
        ]
      }
    ],
    "directories": {
      "buildResources": "assets"
    },
    "extends": null,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "generic",
      "url": "http://47.108.180.116:8080/packages/awamstock"
    }
  },
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ]
}
